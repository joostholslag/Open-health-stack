# ============================================================================
# freshehr-open-health-stack — environment template
# ----------------------------------------------------------------------------
# Copy to docker/.env (or repo-root .env) and fill in real values.
#   cd docker && cp ../.env.example .env
# NO REAL SECRETS in this file — it is committed. Real secrets live in .env
# (gitignored) or, for k8s/terraform, in out-of-band Secrets/tfvars.
# ============================================================================

# ── openFHIR engine ────────────────────────────────────────────────────────
# The stack is self-contained: the openFHIR engine always runs in-cluster (the
# `openfhir` compose service). There is no hosted-sandbox mode.
#
# This REQUIRES the vendor license at docker/openfhir/license/openfhir-license.json
# (gitignored) — the engine will not start without it. Request one at
# https://open-fhir.com#access.
#
# Base URL HAPI's interceptor uses to reach the engine. Rarely needs changing.
OPENFHIR_BASE_URL=http://openfhir:8080

# Override the engine image if you need a specific build. Must be an
# `openfhir-enterprise` image: the Postgres repository implementation ships only
# there, and the community `openfhir` image is Mongo-only.
#OPENFHIR_IMAGE=openfhir/openfhir-enterprise:latest

# ── HAPI FHIR ──────────────────────────────────────────────────────────────
HAPI_FHIR_IPS_ENABLED=true
# Custom HAPI image tag (M3 CI build). For local `docker compose build` this is
# ignored — the image is built from docker/hapi/Dockerfile.
HAPI_IMAGE=openfhir/hapi-openfhir:latest

# ── Shared Postgres (one instance; databases: ehrbase · hapi · openfhir · keycloak) ───
# postgres superuser (owns the cluster; init scripts run as this user)
EHRBASE_PG_SUPERUSER=postgres
EHRBASE_PG_SUPERPASSWORD=postgres
# EHRbase restricted (runtime) user
EHRBASE_DB_USER=ehrbase_restricted
EHRBASE_DB_PASS=ehrbase_restricted
# EHRbase admin (schema management) user
EHRBASE_DB_USER_ADMIN=ehrbase
EHRBASE_DB_PASS_ADMIN=ehrbase
# HAPI's JPA datasource user (DB created by ehrbase/init-db.sql in this same PG)
HAPI_DB_USER=hapi
HAPI_DB_PASS=hapi
# openFHIR's datasource user (DB also created by ehrbase/init-db.sql)
OPENFHIR_DB_USER=openfhir
OPENFHIR_DB_PASS=openfhir
# Keycloak's datasource user (DB also created by ehrbase/init-db.sql)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASS=keycloak

# ── Keycloak / OAuth2 ──────────────────────────────────────────────────────
# Admin console login at http://localhost:8081/auth/admin/ (KC_BOOTSTRAP_ADMIN_*).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Canonical issuer — the in-network URL Keycloak stamps into every token's
# `iss` (KC_HOSTNAME). Host callers still fetch tokens via localhost:8081.
OIDC_ISSUER_URI=http://keycloak:8080/auth/realms/freshehr
# Client secrets. These are FIXED DEV VALUES mirrored in the committed realm
# import (docker/keycloak/realm-freshehr.json) — changing them here without
# changing the realm JSON (or the client in the admin console) breaks auth.
KC_API_CLIENT_SECRET=dev-api-client-secret
KC_HAPI_SVC_SECRET=dev-hapi-svc-secret
OAUTH2_PROXY_CLIENT_SECRET=dev-oauth2-proxy-secret
# Must be exactly 16, 24 or 32 bytes (oauth2-proxy cookie encryption).
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdef0123456789abcdef

# ── EHRbase app ────────────────────────────────────────────────────────────
# OAUTH = native OAuth2 resource server against the freshehr Keycloak realm.
# (The old BASIC mode + EHRBASE_AUTH_USER/PASSWORD are retired.)
EHRBASE_SECURITY_AUTHTYPE=OAUTH
EHRBASE_SERVER_NODENAME=local.ehrbase.org

# ── nginx / TLS ────────────────────────────────────────────────────────────
# Hostname the dev self-signed cert is issued for (see README openssl one-liner).
NGINX_SERVER_NAME=localhost
