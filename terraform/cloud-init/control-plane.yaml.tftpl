#cloud-config
# k3s control-plane bootstrap.
# Templated vars: k3s_version, k3s_token, node_ip (private), flannel_iface,
# network_cidr, private_gateway.
# The public IP (TLS SAN) is fetched at boot from the Hetzner metadata service,
# since it isn't known to Terraform before the server exists.
package_update: true
packages:
  - curl

write_files:
  # Image GC thresholds (kubelet defaults are 85/80). k3s v1.36's kubelet no
  # longer accepts --image-gc-*-threshold-percent as flags ("unknown flag"),
  # so they go in a kubelet config drop-in that k3s loads from this dir.
  - path: /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/10-image-gc.conf
    permissions: "0644"
    content: |
      apiVersion: kubelet.config.k8s.io/v1beta1
      kind: KubeletConfiguration
      imageGCHighThresholdPercent: 70
      imageGCLowThresholdPercent: 60

runcmd:
  # Bring up the Hetzner private-network NIC. The hcloud cloud-init datasource only
  # emits netplan config for the PUBLIC interface (eth0), so ${flannel_iface} exists
  # but stays DOWN with no IPv4. k3s then dies with
  #   "flannel exited: failed to find IPv4 address for interface ${flannel_iface}"
  #   "failed to validate nodeIP: node IP ... not found in the host's network interfaces"
  # Configure it for DHCP and wait until it actually has an address before k3s starts.
  - |
    cat > /etc/netplan/60-private.yaml <<'NETPLAN'
    network:
      version: 2
      ethernets:
        ${flannel_iface}:
          dhcp4: true
          # The private network's DHCP server pushes a route for the metadata
          # service (169.254.169.254) via the private gateway, which blackholes it —
          # on Hetzner that address is only reachable over the PUBLIC interface.
          # Accepting it breaks the public-IP lookup below. Take the address and
          # nothing else; eth0 keeps the default route and the metadata route.
          dhcp4-overrides:
            use-routes: false
          # use-routes: false drops ALL DHCP routes, including the private-network
          # one that agents and flannel need — so re-add that explicitly.
          routes:
            - to: ${network_cidr}
              via: ${private_gateway}
    NETPLAN
    chmod 600 /etc/netplan/60-private.yaml
    netplan apply
    for i in $(seq 1 60); do
      ip -o -4 addr show ${flannel_iface} 2>/dev/null | grep -q inet && break
      sleep 2
    done

  # Install k3s server. Disable the bundled Traefik + ServiceLB — we run
  # ingress-nginx and a Hetzner LB instead. cloud-provider=external so the
  # Hetzner CCM/CSI (installed by the k8s-apps module) manage nodes/volumes.
  #
  # PUBLIC_IP is discovered from the Hetzner metadata service in THIS block, not a
  # preceding one: each runcmd entry runs in its own shell, so an `export` in an
  # earlier entry is gone by the time this one runs. An empty --node-external-ip
  # makes k3s refuse to start ("invalid node-external-ip: invalid ip format ''")
  # and it retries forever rather than failing, so bail out loudly instead.
  - |
    PUBLIC_IP=""
    for i in $(seq 1 30); do
      PUBLIC_IP=$(curl -sf --max-time 5 --interface eth0 http://169.254.169.254/hetzner/v1/metadata/public-ipv4) && [ -n "$PUBLIC_IP" ] && break
      sleep 2
    done
    [ -n "$PUBLIC_IP" ] || { echo "FATAL: could not determine public IPv4 from metadata service" >&2; exit 1; }
    # kubelet's own defaults (85% high / 80% low) don't start reclaiming
    # unused container images until disk usage is already within a few
    # percent of the DiskPressure eviction threshold — this node's cx-line
    # disk is much bigger than Scaleway's default, so it isn't urgent here,
    # but it's the same latent gap: enough upgrade cycles (each briefly
    # running two image generations at once) will eventually reach it too.
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_CHANNEL="${k3s_version}" \
      K3S_TOKEN="${k3s_token}" \
      sh -s - server \
        --disable traefik \
        --disable servicelb \
        --disable-cloud-controller \
        --kubelet-arg=cloud-provider=external \
        --node-ip=${node_ip} \
        --node-external-ip=$PUBLIC_IP \
        --advertise-address=${node_ip} \
        --flannel-iface=${flannel_iface} \
        --tls-san=$PUBLIC_IP \
        --write-kubeconfig-mode=0644
  # Signal readiness — Terraform's remote-exec polls for this file before it
  # pulls the kubeconfig.
  - until k3s kubectl get nodes >/dev/null 2>&1; do sleep 5; done
  - touch /tmp/k3s-ready
